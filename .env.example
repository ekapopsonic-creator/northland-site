# ===== Database — Supabase =====
# Supabase Dashboard → Project Settings → Database → Connection string
# ใช้แบบ "Transaction pooler" (port 6543) สำหรับ deploy บน Vercel
DATABASE_URI=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ===== Payload =====
# ค่าสุ่มยาวๆ อย่างน้อย 32 ตัวอักษร (ใช้เข้ารหัส session) — ห้ามใช้ค่าตัวอย่างนี้จริง
PAYLOAD_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ===== Email — Resend (resend.com) =====
RESEND_API_KEY=
EMAIL_FROM=noreply@northland.co.th
EMAIL_FROM_NAME=Northland Development
# อีเมลทีมขายที่รับแจ้งเตือน lead ใหม่ (คั่นหลายคนด้วย comma ได้)
SALES_NOTIFY_EMAIL=
# อีเมล HR ที่รับแจ้งเตือนใบสมัครงานใหม่
HR_NOTIFY_EMAIL=

# ===== File storage — Cloudflare R2 (S3-compatible) =====
# ปล่อยว่างได้ตอน dev (ไฟล์จะเก็บลงเครื่องแทน) — ต้องใส่ตอน deploy จริง
S3_BUCKET=
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL ของ R2 bucket (R2.dev subdomain หรือ custom domain)
S3_PUBLIC_URL=
